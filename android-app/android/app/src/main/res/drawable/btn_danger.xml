<?xml version="1.0" encoding="utf-8"?>
<!-- Calm filled button: a muted gradient with a faint top highlight (like .btn-danger). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="@color/danger_solid_top" android:endColor="@color/danger_solid_bottom" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <ripple android:color="#33FFFFFF">
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="@color/danger_solid_top" android:endColor="@color/danger_solid_bottom" />
                    <stroke android:width="1dp" android:color="#14000000" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
        </ripple>
    </item>
</selector>
