<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The house look: violet on near-black (or white), Geist. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/bg</item>
        <item name="colorAccent">@color/primary</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:fontFamily">@font/geist</item>
        <item name="fontFamily">@font/geist</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="AppTheme">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- Launch: a violet tile on the app background while the WebView starts. -->
    <style name="AppTheme.Launch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>

    <style name="AppTheme.Dialog" parent="Theme.AppCompat.DayNight.Dialog">
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="android:windowNoTitle">true</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowMinWidthMajor">88%</item>
        <item name="android:windowMinWidthMinor">88%</item>
        <item name="android:fontFamily">@font/geist</item>
        <item name="colorAccent">@color/primary</item>
    </style>

    <style name="AppTheme.Sheet" parent="AppTheme.Dialog" />

    <style name="Text" parent="">
        <item name="android:fontFamily">@font/geist</item>
        <item name="android:textColor">@color/fg</item>
    </style>
    <style name="Text.Title">
        <item name="android:textSize">17sp</item>
        <item name="android:textFontWeight">600</item>
    </style>
    <style name="Text.Body">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/muted_fg</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>

    <style name="Button" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:fontFamily">@font/geist</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="Button.Primary">
        <item name="android:background">@drawable/btn_primary</item>
        <item name="android:textColor">#FAFAFA</item>
    </style>
    <style name="Button.Danger">
        <item name="android:background">@drawable/btn_danger</item>
        <item name="android:textColor">#FAFAFA</item>
    </style>
    <style name="Button.Secondary">
        <item name="android:background">@drawable/btn_secondary</item>
        <item name="android:textColor">@color/fg</item>
    </style>

    <style name="WidgetText" parent="">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/widget_fg</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>
</resources>
