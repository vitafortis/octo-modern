# Where the encrypted store and key file live.
OCM_DATA_DIR=./data

# Optional master secret. If unset, a random 256-bit key is written to $OCM_DATA_DIR/secret.key.
# OCM_SECRET_KEY=

# Create the first admin on start instead of using the setup wizard.
# OCM_ADMIN_EMAIL=you@example.com
# OCM_ADMIN_PASSWORD=
# OCM_ADMIN_NAME=

# Set to "disabled" to skip the login screen (trusted networks only).
# OCM_AUTH=disabled

# Hide the email/password form once SSO works.
# OCM_LOCAL_LOGIN=disabled

# Single sign-on (OIDC). Register <your-url>/auth/oidc/callback as the redirect URI.
# OCM_OIDC_ISSUER=https://auth.example.com/application/o/octo-modern/
# OCM_OIDC_CLIENT_ID=octo-modern
# OCM_OIDC_CLIENT_SECRET=
# OCM_OIDC_NAME=Authentik
# OCM_OIDC_SCOPES=openid email profile
# Who gets an account on first login, who of those is an admin, and everyone else's role.
# OCM_OIDC_AUTO_CREATE=*@example.com,friend@gmail.com
# OCM_OIDC_ADMIN_EMAILS=you@example.com
# OCM_OIDC_DEFAULT_ROLE=viewer

# Talking to OctoPrint.
# OCM_POLL_INTERVAL_MS=10000       # status poll for printers nobody is watching
# OCM_REQUEST_TIMEOUT_MS=10000     # per request to OctoPrint
# OCM_PUSH_THROTTLE=2              # live updates every 500 ms × this
# OCM_TEMP_HISTORY_MINUTES=30      # temperature history kept in memory
