{
	"name": "octo-modern",
	"private": true,
	"version": "0.1.0",
	"license": "Apache-2.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev --port 3040",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p src/service-worker",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "node --no-warnings --experimental-strip-types --test tests/*.test.ts",
		"e2e": "node scripts/e2e/run.mjs",
		"e2e:control": "node scripts/e2e/control.mjs",
		"e2e:discover": "node scripts/e2e/discover.mjs",
		"e2e:library": "node scripts/e2e/library.mjs",
		"e2e:history": "node scripts/e2e/history.mjs",
		"e2e:notify": "node scripts/e2e/notify.mjs",
		"e2e:power": "node scripts/e2e/power.mjs",
		"e2e:mobile": "node scripts/e2e/mobile.mjs",
		"e2e:detect": "node scripts/e2e/detect.mjs",
		"e2e:queue": "node scripts/e2e/queue.mjs",
		"e2e:spools": "node scripts/e2e/spools.mjs",
		"e2e:viewer": "node scripts/e2e/viewer.mjs",
		"e2e:stats": "node scripts/e2e/stats.mjs",
		"e2e:bedmesh": "node scripts/e2e/bedmesh.mjs",
		"e2e:push": "node scripts/e2e/push.mjs",
		"e2e:klipper": "node scripts/e2e/klipper.mjs",
		"e2e:preprint": "node scripts/e2e/preprint.mjs",
		"e2e:android": "node scripts/e2e/android.mjs"
	},
	"devDependencies": {
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource-variable/geist-mono": "^5.3.0",
		"@lucide/svelte": "^1.53.0",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.4",
		"@types/nodemailer": "^8.0.2",
		"@types/smtp-server": "^3.5.13",
		"@types/ssh2-sftp-client": "^9.0.6",
		"playwright": "1",
		"smtp-server": "^3.19.21",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"jpeg-js": "^0.4.4",
		"nodemailer": "^10.1.0",
		"openid-client": "^6.8.8",
		"smb3-client": "0.2.0",
		"ssh2-sftp-client": "^12.1.1",
		"undici": "^7.16.0"
	},
	"packageManager": "pnpm@9.15.0",
	"engines": {
		"node": ">=24"
	},
	"pnpm": {
		"neverBuiltDependencies": [
			"ssh2",
			"cpu-features"
		],
		"patchedDependencies": {
			"smb3-client@0.2.0": "patches/smb3-client@0.2.0.patch"
		}
	}
}
